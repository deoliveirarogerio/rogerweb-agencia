---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object;
  noindex?: boolean;
}

const {
  title,
  description,
  keywords = 'desenvolvimento web, marketing digital, meta ads, google ads, sites, sistemas web, e-commerce, agência digital',
  canonical = 'https://rogerweb.com.br/',
  ogImage = 'https://rogerweb.com.br/assets/images/logo-rogerweb.png',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-P6BHKD8');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BHMV0EHP7V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BHMV0EHP7V');
    </script>
    <script is:inline>
      window.rogerwebTrack = function(eventName, parameters = {}) {
        try {
          const consent = JSON.parse(localStorage.getItem('lgpd-consent') || 'null');
          if (consent?.choice !== 'accepted') return;
        } catch {
          return;
        }

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: eventName, ...parameters });
      };

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('a') : null;
        if (!target) return;

        const href = target.getAttribute('href') || '';
        const source = target.dataset.analyticsSource
          || target.closest('[data-analytics-source]')?.dataset.analyticsSource
          || location.pathname;
        let eventName = target.dataset.analyticsEvent;

        if (!eventName && /^https?:\/\/(?:api\.)?wa\.me\//i.test(href)) {
          eventName = 'whatsapp_click';
          const local = target.dataset.local || 'indefinido';
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'whatsapp_click',
            local,
            page: location.pathname,
          });
        } else if (!eventName && href.startsWith('mailto:')) {
          eventName = 'email_click';
        } else if (!eventName && href.startsWith('tel:')) {
          eventName = 'phone_click';
        } else if (!eventName && href) {
          try {
            const destination = new URL(href, location.href);
            const path = destination.pathname.replace(/\/$/, '');
            if (
              destination.origin === location.origin
              && (destination.hash === '#contato' || path === '/contato')
            ) {
              eventName = 'contact_cta_click';
            }
          } catch {
            return;
          }
        }

        if (eventName) window.rogerwebTrack(eventName, { event_source: source });
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <slot name="head" />
  </head>
  <body class="gradient-bg min-h-screen text-white">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P6BHKD8"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <slot />
    <CookieConsent />
    <ExitIntentModal />
  </body>
</html>
