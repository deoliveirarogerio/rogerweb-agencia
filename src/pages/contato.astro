---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ContactForm from '../components/ContactForm.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contato - RogerWeb',
  description: 'Fale com a equipe da RogerWeb. Solicite um orçamento gratuito para desenvolvimento web, sistemas e marketing digital.',
  url: 'https://rogerweb.com.br/contato',
  mainEntity: {
    '@type': 'Organization',
    name: 'RogerWeb',
    telephone: '+55-11-91213-6490',
    email: 'contato@rogerweb.com.br',
  },
};
---

<BaseLayout
  title="Contato - RogerWeb | Fale com Nossos Especialistas"
  description="Entre em contato com a RogerWeb e receba uma análise gratuita do seu negócio. Desenvolvimento de sites, sistemas web e estratégias de marketing digital."
  keywords="contato rogerweb, orçamento site, orçamento sistema web, agência digital são paulo, falar com especialista"
  canonical="https://rogerweb.com.br/contato"
  jsonLd={jsonLd}
>
  <Navbar currentPage="contato" />

  <!-- Hero Header -->
  <section class="pt-32 pb-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute inset-0 bg-primary-500/5"></div>
    <div class="max-w-7xl mx-auto text-center relative">
      <span class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-primary-400 bg-primary-500/10 px-4 py-1.5 rounded-full border border-primary-500/20 inline-block mb-4">
        Atendimento Rápido e Personalizado
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6">
        Vamos construir algo <span class="gradient-text">incrível</span> juntos?
      </h1>
      <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto">
        Tire sua ideia do papel ou impulsione os resultados do seu negócio atual. Preencha o formulário ou entre em contato direto pelo WhatsApp.
      </p>
    </div>
  </section>

  <!-- Contact Main Section -->
  <section class="pb-20 px-4 sm:px-6 lg:px-8 lg:mt-8 relative">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-12 gap-12 items-start">
        
        <!-- Contact Information (Left Column) -->
        <div class="lg:col-span-5 space-y-8">
          <div class="bg-dark-800/60 backdrop-blur-md border border-primary-500/20 rounded-3xl p-8 shadow-xl">
            <h2 class="text-2xl font-bold text-white mb-6">Canais de Atendimento</h2>
            
            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-primary-500/20 rounded-xl flex items-center justify-center flex-shrink-0 text-primary-400">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wider text-gray-400 font-medium">E-mail Principal</p>
                  <a href="mailto:contato@rogerweb.com.br" class="text-white font-semibold hover:text-primary-400 transition-colors">
                    contato@rogerweb.com.br
                  </a>
                  <p class="text-xs text-gray-400 mt-1">Resposta em até 24h úteis</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-accent-500/20 rounded-xl flex items-center justify-center flex-shrink-0 text-accent-400">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wider text-gray-400 font-medium">Telefone / WhatsApp</p>
                  <a href="https://wa.me/5511912136490" target="_blank" rel="noopener noreferrer" class="text-white font-semibold hover:text-accent-400 transition-colors">
                    (11) 91213-6490
                  </a>
                  <p class="text-xs text-gray-400 mt-1">Atendimento imediato via chat</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-primary-500/20 rounded-xl flex items-center justify-center flex-shrink-0 text-primary-400">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wider text-gray-400 font-medium">Localização</p>
                  <p class="text-white font-semibold">São Paulo - SP, Brasil</p>
                  <p class="text-xs text-gray-400 mt-1">Atendemos todo o Brasil e exterior</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-primary-500/20 rounded-xl flex items-center justify-center flex-shrink-0 text-primary-400">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wider text-gray-400 font-medium">Horário de Atendimento</p>
                  <p class="text-white font-semibold">Segunda a Sexta: 09h às 18h</p>
                  <p class="text-xs text-gray-400 mt-1">Plantão 24/7 para clientes com SLA</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Direct WhatsApp CTA Box -->
          <a
            href="https://wa.me/5511912136490"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between p-6 bg-gradient-to-r from-green-600/90 to-emerald-600/90 hover:from-green-500 hover:to-emerald-500 rounded-3xl transition-all duration-300 shadow-xl hover:scale-[1.02] border border-green-400/30"
          >
            <div class="flex items-center space-x-4">
              <img
                src="/assets/images/mascote-whatsapp.jpg"
                alt="Mascote WhatsApp"
                class="w-14 h-14 rounded-2xl object-cover border-2 border-white/40 shadow"
              />
              <div>
                <span class="inline-block px-2.5 py-0.5 bg-white/20 text-white rounded-full text-xs font-semibold uppercase tracking-wider mb-1">
                  Online Agora
                </span>
                <h3 class="text-lg font-bold text-white">Chamar no WhatsApp</h3>
                <p class="text-green-100 text-sm">Resposta em menos de 5 minutos</p>
              </div>
            </div>
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white group-hover:translate-x-1 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>

          <!-- FAQ Card -->
          <div class="bg-dark-800/40 border border-primary-500/20 rounded-3xl p-6">
            <h3 class="text-lg font-bold text-white mb-4">Dúvidas Frequentes</h3>
            <div class="space-y-3 text-sm text-gray-300">
              <details class="group cursor-pointer">
                <summary class="font-medium text-white group-hover:text-primary-400 transition-colors flex justify-between items-center">
                  <span>Qual o prazo médio de entrega?</span>
                  <span class="text-primary-400">+</span>
                </summary>
                <p class="mt-2 text-gray-400 pl-2 border-l-2 border-primary-500/30">
                  Landing pages em 5 a 10 dias úteis. Sites institucionais de 2 a 4 semanas. Sistemas web sob medida dependem do escopo (estimado no orçamento).
                </p>
              </details>
              <details class="group cursor-pointer pt-2 border-t border-primary-500/10">
                <summary class="font-medium text-white group-hover:text-primary-400 transition-colors flex justify-between items-center">
                  <span>A análise inicial é realmente gratuita?</span>
                  <span class="text-primary-400">+</span>
                </summary>
                <p class="mt-2 text-gray-400 pl-2 border-l-2 border-primary-500/30">
                  Sim, fazemos um diagnóstico completo da sua presença digital e proposta sob medida sem nenhum custo ou compromisso.
                </p>
              </details>
            </div>
          </div>
        </div>

        <!-- Form Card (Right Column) -->
        <div class="lg:col-span-7 bg-dark-800/60 backdrop-blur-md border border-primary-500/20 rounded-3xl p-8 sm:p-10 shadow-2xl">
          <div class="mb-8">
            <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2">Solicite sua Análise Gratuita</h2>
            <p class="text-gray-400 text-sm sm:text-base">
              Preencha os campos abaixo com as informações do seu projeto. Entraremos em contato com uma proposta detalhada.
            </p>
          </div>
          
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>
