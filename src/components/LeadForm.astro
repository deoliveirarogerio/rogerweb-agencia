---
interface Props {
  kind: 'contato' | 'orcamento';
  nicho?: string;
}

const { kind, nicho } = Astro.props;
const endpoint = kind === 'orcamento' ? '/api/contato/orcamento' : '/api/contato';
const showEmail = kind === 'contato';
const showService = kind === 'contato';
---

<form data-lead-form data-kind={kind} data-nicho={nicho || ''} novalidate class="space-y-6">
  <!-- honeypot -->
  <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none">
    <label for="website">Website <input type="text" id="website" name="website" tabindex="-1" autocomplete="off"></label>
  </div>
  <input type="hidden" name="ts">
  <input type="hidden" name="nicho" value={nicho || ''}>
  <input type="hidden" name="gclid">
  <input type="hidden" name="gbraid">
  <input type="hidden" name="wbraid">
  <input type="hidden" name="utm_source">
  <input type="hidden" name="utm_medium">
  <input type="hidden" name="utm_campaign">
  <input type="hidden" name="utm_term">
  <input type="hidden" name="landing">

  <div>
    <label for="nome" class="block text-sm font-medium text-gray-300 mb-2">Nome *</label>
    <input
      type="text"
      id="nome"
      name="nome"
      required
      maxlength="80"
      autocomplete="name"
      class="w-full px-4 py-3 bg-dark-900 border border-primary-500/30 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-primary-500"
      placeholder="Seu nome completo"
    />
  </div>

  {showEmail && (
    <div>
      <label for="email" class="block text-sm font-medium text-gray-300 mb-2">E-mail *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        maxlength="120"
        autocomplete="email"
        class="w-full px-4 py-3 bg-dark-900 border border-primary-500/30 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-primary-500"
        placeholder="seu@email.com"
      />
    </div>
  )}

  <div>
    <label for="whatsapp" class="block text-sm font-medium text-gray-300 mb-2">
      {showEmail ? 'Telefone / WhatsApp *' : 'WhatsApp *'}
    </label>
    <input
      type="tel"
      id="whatsapp"
      name={showEmail ? 'telefone' : 'whatsapp'}
      required
      maxlength="20"
      inputmode="tel"
      autocomplete="tel"
      class="w-full px-4 py-3 bg-dark-900 border border-primary-500/30 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-primary-500"
      placeholder="(11) 91080-2646"
    />
  </div>

  {showService && (
    <div>
      <label for="servico" class="block text-sm font-medium text-gray-300 mb-2">Serviço de interesse</label>
      <select
        id="servico"
        name="servico"
        class="w-full px-4 py-3 bg-dark-900 border border-primary-500/30 rounded-lg text-white focus:outline-none focus:border-primary-500"
      >
        <option value="">Selecione uma opção</option>
        <option value="site-institucional">Site institucional</option>
        <option value="landing-page">Landing page</option>
        <option value="loja-virtual">Loja virtual</option>
        <option value="sistema-web">Sistema web sob medida</option>
        <option value="marketing-digital">Marketing digital</option>
        <option value="outro">Outro</option>
      </select>
    </div>
  )}

  <div>
    <label for="mensagem" class="block text-sm font-medium text-gray-300 mb-2">Mensagem (opcional)</label>
    <textarea
      id="mensagem"
      name="mensagem"
      rows="4"
      maxlength="2000"
      class="w-full px-4 py-3 bg-dark-900 border border-primary-500/30 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-primary-500 resize-none"
      placeholder="Conte um pouco sobre seu projeto..."
    ></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="lgpd"
      name="lgpd"
      required
      class="mt-1 w-4 h-4 text-primary-600 bg-dark-900 border border-primary-500/30 rounded"
    />
    <label for="lgpd" class="text-sm text-gray-400">
      Concordo com a <a href="/privacidade" class="text-primary-400 hover:text-primary-300 underline">Política de Privacidade</a> *
    </label>
  </div>

  <div class="cf-turnstile" data-sitekey="0x4AAAAAAFtSQ-LgQwwSvq4C" data-action="lead" data-language="pt-br"></div>

  <button
    type="submit"
    class="w-full bg-primary-600 hover:bg-primary-700 px-6 py-4 rounded-full font-semibold text-lg transition-all hover:scale-105"
  >
    {kind === 'orcamento' ? 'Receber orçamento grátis' : 'Enviar mensagem'}
  </button>

  <p data-status role="status" aria-live="polite" class="text-sm text-gray-400"></p>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const ATTR_KEYS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term'];
  try {
    const q = new URLSearchParams(location.search);
    if (ATTR_KEYS.some((k) => q.get(k))) {
      sessionStorage.setItem('rw_attr', JSON.stringify({
        ...Object.fromEntries(ATTR_KEYS.map((k) => [k, q.get(k) || ''])),
        landing: location.pathname,
      }));
    }
  } catch {}

  document.querySelectorAll('form[data-lead-form]').forEach((form) => {
    const kind = form.dataset.kind;
    const endpoint = kind === 'orcamento' ? '/api/contato/orcamento' : '/api/contato';
    const status = form.querySelector('[data-status]');
    const btn = form.querySelector('button[type=submit]');
    form.ts.value = String(Date.now());
    try {
      const a = JSON.parse(sessionStorage.getItem('rw_attr') || '{}');
      for (const [k, v] of Object.entries(a)) {
        if (form[k]) form[k].value = v;
      }
    } catch {}

    let started = false;
    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      window.dataLayer?.push({
        event: 'form_start',
        form_id: kind,
        nicho: form.dataset.nicho || '',
      });
    }, { once: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      btn.disabled = true;
      status.textContent = 'Enviando...';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const out = await res.json().catch(() => ({ ok: false }));
        if (res.ok && out.ok) {
          if (out.leadId) {
            window.dataLayer?.push({
              event: 'generate_lead',
              form_id: kind,
              nicho: form.dataset.nicho || '',
              lead_id: out.leadId,
              value: 1,
              currency: 'BRL',
            });
            if (kind === 'orcamento') {
              window.showToast('Orçamento enviado com sucesso! Redirecionando...', 'success');
              setTimeout(() => {
                window.location.href = '/criacao-sites/obrigado/';
              }, 300);
            } else {
              window.showToast('Mensagem enviada com sucesso! Retornamos em breve.', 'success');
              form.reset();
            }
          } else {
            window.showToast('Mensagem enviada!', 'success');
            form.reset();
          }
          status.textContent = '';
        } else {
          const errorMsg =
            res.status === 429
              ? 'Muitas tentativas. Aguarde alguns segundos e tente de novo.'
              : 'Não foi possível enviar. Confira os campos ou fale com a gente pelo WhatsApp.';
          window.showToast(errorMsg, 'error');
          status.textContent = errorMsg;
          window.dataLayer?.push({
            event: 'form_error',
            form_id: kind,
            error: out.error || String(res.status),
          });
        }
      } catch {
        window.showToast('Falha de conexão. Tente novamente.', 'error');
        status.textContent = 'Falha de conexão. Tente novamente.';
      } finally {
        if (window.turnstile) {
          window.turnstile.reset(form.querySelector('.cf-turnstile'));
        }
        form.ts.value = String(Date.now() - 3000);
        btn.disabled = false;
      }
    });
  });
</script>
