---
interface Props {
  currentPage?: 'home' | 'sobre' | 'contato' | 'privacidade' | 'blog';
}

const { currentPage = 'home' } = Astro.props;

const linkClass = (page: string) =>
  currentPage === page
    ? 'text-primary-400 font-semibold'
    : 'text-gray-300 hover:text-primary-400 transition-colors';
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-dark-900/60 backdrop-blur-md border-b border-primary-500/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <div class="flex items-center space-x-3">
        <a href="/" class="flex items-center">
          <img src="/assets/images/logo-rogerweb.png" alt="RogerWeb Logo" class="h-11 w-auto" />
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center space-x-8">
        {currentPage === 'home' ? (
          <>
            <a href="#servicos" class="text-gray-300 hover:text-primary-400 transition-colors">Serviços</a>
            <a href="#portfolio" class="text-gray-300 hover:text-primary-400 transition-colors">Portfólio</a>
            <a href="/sobre" class="text-gray-300 hover:text-primary-400 transition-colors">Sobre</a>
            <a href="/contato" class="text-gray-300 hover:text-primary-400 transition-colors">Contato</a>
            <a href="/blog" class={linkClass('blog')}>Blog</a>
            <a href="#contato" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2.5 rounded-full font-semibold transition-all hover:scale-105 shadow-md shadow-primary-600/20">
              Orçamento Grátis
            </a>
          </>
        ) : (
          <>
            <a href="/" class="text-gray-300 hover:text-primary-400 transition-colors">Início</a>
            <a href="/#servicos" class="text-gray-300 hover:text-primary-400 transition-colors">Serviços</a>
            <a href="/#portfolio" class="text-gray-300 hover:text-primary-400 transition-colors">Portfólio</a>
            <a href="/sobre" class={linkClass('sobre')}>Sobre</a>
            <a href="/contato" class={linkClass('contato')}>Contato</a>
            <a href="/blog" class={linkClass('blog')}>Blog</a>
            <a href="/contato" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2.5 rounded-full font-semibold transition-all hover:scale-105 shadow-md shadow-primary-600/20">
              Orçamento Grátis
            </a>
          </>
        )}
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2 rounded-lg hover:bg-primary-500/10 focus:outline-none" aria-label="Abrir menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-dark-900/95 backdrop-blur-xl border-b border-primary-500/20">
    <div class="px-4 py-5 space-y-3">
      {currentPage === 'home' ? (
        <>
          <a href="#servicos" class="block text-gray-300 hover:text-primary-400 py-2">Serviços</a>
          <a href="#portfolio" class="block text-gray-300 hover:text-primary-400 py-2">Portfólio</a>
          <a href="/sobre" class="block text-gray-300 hover:text-primary-400 py-2">Sobre</a>
          <a href="/contato" class="block text-gray-300 hover:text-primary-400 py-2">Contato</a>
          <a href="/blog" class="block text-gray-300 hover:text-primary-400 py-2">Blog</a>
          <a href="#contato" class="block bg-primary-600 hover:bg-primary-700 text-center text-white px-6 py-3 rounded-full font-semibold">Orçamento Grátis</a>
        </>
      ) : (
        <>
          <a href="/" class="block text-gray-300 hover:text-primary-400 py-2">Início</a>
          <a href="/#servicos" class="block text-gray-300 hover:text-primary-400 py-2">Serviços</a>
          <a href="/#portfolio" class="block text-gray-300 hover:text-primary-400 py-2">Portfólio</a>
          <a href="/sobre" class={`block py-2 ${linkClass('sobre')}`}>Sobre</a>
          <a href="/contato" class={`block py-2 ${linkClass('contato')}`}>Contato</a>
          <a href="/blog" class={`block py-2 ${linkClass('blog')}`}>Blog</a>
          <a href="/contato" class="block bg-primary-600 hover:bg-primary-700 text-center text-white px-6 py-3 rounded-full font-semibold">Orçamento Grátis</a>
        </>
      )}
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (!navbar) return;
    if (window.scrollY > 40) {
      navbar.classList.add('bg-dark-900/95', 'shadow-lg');
      navbar.classList.remove('bg-dark-900/60');
    } else {
      navbar.classList.add('bg-dark-900/60');
      navbar.classList.remove('bg-dark-900/95', 'shadow-lg');
    }
  });

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        mobileMenu?.classList.add('hidden');
      }
    });
  });
</script>
