---
import { waLink } from '../../data/contato';
---
<section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
        O que fazemos
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8 card-hover flex flex-col">
        <div class="w-14 h-14 bg-primary-500/20 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-7 h-7 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Site institucional para empresa</h3>
        <p class="text-gray-400 mb-4 flex-grow">Páginas de serviços, quem somos, contato e mapa.</p>
        <a
          href={waLink('Quero orçamento de site institucional')}
          data-track="whatsapp"
          data-local="servico-institucional"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-400 hover:text-primary-300 font-semibold transition-colors"
        >
          Quero esse →
        </a>
      </div>

      <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8 card-hover flex flex-col">
        <div class="w-14 h-14 bg-accent-500/20 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-7 h-7 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Landing page profissional</h3>
        <p class="text-gray-400 mb-4 flex-grow">Página única focada em conversão, ideal para Google Ads e Instagram.</p>
        <a
          href={waLink('Quero orçamento de landing page')}
          data-track="whatsapp"
          data-local="servico-landing"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-400 hover:text-primary-300 font-semibold transition-colors"
        >
          Quero esse →
        </a>
      </div>

      <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8 card-hover flex flex-col">
        <div class="w-14 h-14 bg-primary-500/20 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-7 h-7 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Loja virtual</h3>
        <p class="text-gray-400 mb-4 flex-grow">Catálogo, carrinho e pagamento (MercadoPago/Pix).</p>
        <a
          href={waLink('Quero orçamento de loja virtual')}
          data-track="whatsapp"
          data-local="servico-loja"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-400 hover:text-primary-300 font-semibold transition-colors"
        >
          Quero esse →
        </a>
      </div>

      <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8 card-hover flex flex-col">
        <div class="w-14 h-14 bg-accent-500/20 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-7 h-7 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Sistemas web sob medida</h3>
        <p class="text-gray-400 mb-4 flex-grow">Agendamentos, áreas de cliente, painéis (Laravel + Vue).</p>
        <a
          href={waLink('Quero orçamento de sistema web')}
          data-track="whatsapp"
          data-local="servico-sistema"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-400 hover:text-primary-300 font-semibold transition-colors"
        >
          Quero esse →
        </a>
      </div>
    </div>
  </div>
</section>
