<style>
  .sites-carousel {
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .site-card {
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center center;
  }

  .site-card[data-index="0"] {
    transform: translateZ(0px) rotateY(0deg);
    z-index: 3;
  }

  .site-card[data-index="1"] {
    transform: translateZ(-60px) rotateY(30deg) translateX(40px);
    z-index: 2;
    opacity: 0.8;
  }

  .site-card[data-index="2"] {
    transform: translateZ(-120px) rotateY(60deg) translateX(80px);
    z-index: 1;
    opacity: 0.6;
  }
</style>

<script>
  let currentIndex = 0;
  const cards = document.querySelectorAll('.site-card');

  function rotateCards() {
    cards.forEach((card, index) => {
      const newIndex = (index - currentIndex + 3) % 3;
      card.setAttribute('data-index', newIndex);
    });
    currentIndex = (currentIndex + 1) % 3;
  }

  setInterval(rotateCards, 3000);
</script>
