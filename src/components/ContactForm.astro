<form id="contact-form" class="space-y-6">
  <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div>
    <label class="block text-gray-300 mb-2" for="nome">Nome Completo</label>
    <input
      type="text"
      id="nome"
      name="nome"
      class="w-full bg-dark-900/50 border border-primary-500/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary-500 transition-colors"
      placeholder="Seu nome"
      required
    />
  </div>
  <div>
    <label class="block text-gray-300 mb-2" for="email">E-mail</label>
    <input
      type="email"
      id="email"
      name="email"
      class="w-full bg-dark-900/50 border border-primary-500/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary-500 transition-colors"
      placeholder="seu@email.com"
      required
    />
  </div>
  <div>
    <label class="block text-gray-300 mb-2" for="telefone">Telefone</label>
    <input
      type="tel"
      id="telefone"
      name="telefone"
      class="w-full bg-dark-900/50 border border-primary-500/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary-500 transition-colors"
      placeholder="(11) 99999-9999"
      required
    />
  </div>
  <div>
    <label class="block text-gray-300 mb-2" for="servico">Serviço de Interesse</label>
    <select
      id="servico"
      name="servico"
      class="w-full bg-dark-900/50 border border-primary-500/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary-500 transition-colors"
      required
    >
      <option value="">Selecione um serviço</option>
      <option value="sites">Desenvolvimento de Sites</option>
      <option value="sistemas">Sistemas Web</option>
      <option value="marketing">Marketing Digital</option>
      <option value="meta-ads">Meta Ads (Facebook/Instagram)</option>
      <option value="google-ads">Google Ads</option>
      <option value="campanhas">Estratégias de Campanhas</option>
      <option value="design">Design UI/UX</option>
      <option value="ecommerce">E-commerce</option>
      <option value="outro">Outro</option>
    </select>
  </div>
  <div>
    <label class="block text-gray-300 mb-2" for="mensagem">Mensagem</label>
    <textarea
      id="mensagem"
      name="mensagem"
      rows="4"
      class="w-full bg-dark-900/50 border border-primary-500/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary-500 transition-colors resize-none"
      placeholder="Descreva seu projeto..."
      required
    ></textarea>
  </div>
  <button
    type="submit"
    class="w-full bg-primary-600 hover:bg-primary-700 px-8 py-4 rounded-full font-semibold text-lg transition-all hover:scale-105"
  >
    Quero Minha Análise Gratuita
  </button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
    if (honeypot?.value) return;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent ?? '';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';

    const formData = new FormData(form);
    const nome = formData.get('nome') as string;
    const email = formData.get('email') as string;
    const telefone = formData.get('telefone') as string;
    const servico = formData.get('servico') as string;
    const mensagem = formData.get('mensagem') as string;

    const whatsappMessage = encodeURIComponent(
      `Olá! Gostaria de uma análise gratuita.\n\nNome: ${nome}\nE-mail: ${email}\nTelefone: ${telefone}\nServiço: ${servico}\n\nMensagem:\n${mensagem}`
    );

    try {
      const payload = new FormData();
      payload.append('name', nome);
      payload.append('email', email);
      payload.append('phone', telefone);
      payload.append('service', servico);
      payload.append('message', mensagem);
      payload.append('_subject', 'Nova Solicitação de Orçamento - RogerWeb');
      payload.append('_captcha', 'false');
      payload.append('_template', 'table');

      const response = await fetch('https://formsubmit.co/ajax/contato@rogerweb.com.br', {
        method: 'POST',
        body: payload,
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        alert('Solicitação enviada com sucesso! Entraremos em contato em até 24 horas.');
        form.reset();
      } else {
        throw new Error('FormSubmit failed');
      }
    } catch {
      const openWhatsApp = confirm(
        'Não foi possível enviar pelo formulário. Deseja continuar pelo WhatsApp?'
      );
      if (openWhatsApp) {
        window.open(`https://wa.me/5511912136490?text=${whatsappMessage}`, '_blank');
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
