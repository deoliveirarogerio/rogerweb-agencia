---
import { waLink } from '../data/contato';
---
<a
  href={waLink('Olá! Vim pelo site e gostaria de saber mais.')}
  data-track="whatsapp"
  data-local="float"
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 bg-green-600 hover:bg-green-700 rounded-full p-1 shadow-2xl transition-all hover:scale-110 pulse-glow group"
>
  <img src="/assets/images/mascote-whatsapp.jpg" alt="WhatsApp" class="w-14 h-14 rounded-full" />
  <span class="absolute right-full mr-3 top-1/2 -translate-y-1/2 bg-white text-gray-900 px-3 py-1 rounded-lg text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap shadow-lg">
    Fale conosco!
  </span>
</a>
