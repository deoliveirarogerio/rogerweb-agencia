<div id="cookie-consent" class="fixed inset-x-0 bottom-0 z-[60] hidden" aria-live="polite" role="dialog" aria-label="Aviso de privacidade">
  <div class="max-w-4xl mx-4 sm:mx-auto mb-4 sm:mb-6">
    <div class="relative bg-dark-800/95 backdrop-blur-xl border border-primary-500/30 rounded-2xl shadow-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
      <div class="flex items-start gap-3 flex-1">
        <div class="w-10 h-10 bg-primary-500/20 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-6 h-6 text-primary-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 2a8 8 0 108 8.8c-.3 1.2-.9 1.8-1.9 1.8-.8 0-1.3-.5-1.3-1.2 0-1.2.4-2.4 0-3.2-.5-.9-1.5-1.4-2.4-1.4-1.1 0-2 .8-2 1.9 0 .5-.4 1-1 1-.6 0-1-.4-1-1 0-1.7 2-3.6 2-3.6C10.6 5.9 11 5 11 4c0-1-.7-1.8-1-2A8 8 0 0010 2zm.01 9.5c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="space-y-1.5">
          <h3 class="text-white font-semibold text-base sm:text-lg">Aviso de Privacidade e Cookies</h3>
          <p class="text-gray-400 text-xs sm:text-sm leading-relaxed">
            Utilizamos dados e cookies para melhorar a sua experiência, personalizar o atendimento e gerar estatísticas de navegação, em conformidade com a LGPD (Lei nº 13.709/2018). Saiba mais na nossa
            <a href="/privacidade" class="text-primary-400 hover:text-primary-300 underline" target="_blank" rel="noopener noreferrer">Política de Privacidade</a>.
          </p>
          <p class="text-gray-500 text-xs">
            Você pode alterar ou revogar a sua escolha a qualquer momento.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
        <button
          type="button"
          id="cookie-accept"
          class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-3 rounded-full font-semibold text-sm transition-all hover:scale-105 whitespace-nowrap"
        >
          Aceitar Todos
        </button>
        <button
          type="button"
          id="cookie-essential"
          class="border border-primary-500/40 text-gray-300 hover:bg-primary-500/10 hover:text-white px-6 py-3 rounded-full font-semibold text-sm transition-all whitespace-nowrap"
        >
          Somente Essenciais
        </button>
      </div>

      <button
        type="button"
        id="cookie-close"
        class="absolute top-3 right-3 text-gray-500 hover:text-white transition-colors p-1 rounded-lg hover:bg-primary-500/10"
        aria-label="Fechar aviso"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'lgpd-consent';
  type ConsentValue = 'accepted' | 'rejected';

  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const essentialBtn = document.getElementById('cookie-essential');
  const closeBtn = document.getElementById('cookie-close');

  function setConsent(value: ConsentValue) {
    try {
      const record = {
        choice: value,
        date: new Date().toISOString(),
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
    } catch {
      // localStorage indisponível (ex.: modo anônimo) - segue silenciosamente
    }
    banner?.classList.add('hidden');
  }

  acceptBtn?.addEventListener('click', () => setConsent('accepted'));
  essentialBtn?.addEventListener('click', () => setConsent('rejected'));
  closeBtn?.addEventListener('click', () => setConsent('rejected'));

  (function init() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (!stored) {
        banner?.classList.remove('hidden');
        banner?.classList.add('cookie-consent-enter');
        return;
      }
    } catch {
      banner?.classList.remove('hidden');
      banner?.classList.add('cookie-consent-enter');
    }
  })();
</script>