---
interface Props {
  dores: Array<{ titulo: string; texto: string }>;
}

const { dores } = Astro.props;
---

<section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-primary-500/5 to-transparent"></div>
  <div class="max-w-7xl mx-auto relative">
    <div class="text-center mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
        Problemas que você enfrenta hoje
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
      {dores.map((dor) => (
        <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8 card-hover">
          <div class="w-14 h-14 bg-red-500/20 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-2">{dor.titulo}</h3>
          <p class="text-gray-400">{dor.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
