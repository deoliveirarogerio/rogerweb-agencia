---
import { waLink } from '../../data/contato';
interface Props {
  h1: string;
  subtitulo: string;
  ctaTexto: string;
  whatsappMsg: string;
  slug: string;
  icone: string;
}

const { h1, subtitulo, ctaTexto, whatsappMsg, slug, icone } = Astro.props;
const wa = waLink(whatsappMsg);

const heroImages = {
  barbearias: 'https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=1920&q=80',
  'saloes-de-beleza': 'https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1920&q=80',
  'clinicas-medicas': 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1920&q=80',
  laboratorios: 'https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=1920&q=80',
  imobiliarias: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=1920&q=80',
  contabilidade: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=1920&q=80',
  'comercio-local': 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1920&q=80',
};

const heroImage = heroImages[slug as keyof typeof heroImages] || heroImages.barbearias;
---

<section class="pt-24 sm:pt-36 pb-24 sm:pb-32 lg:pb-40 px-4 sm:px-6 lg:px-8 relative overflow-hidden min-h-[95vh]">
  <div class="absolute inset-0">
    <img
      src={heroImage}
      alt=""
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-dark-900/95 via-dark-900/80 to-dark-900/40"></div>
  </div>

  <div class="max-w-7xl mx-auto relative">
    <div class="grid lg:grid-cols-2 gap-8 sm:gap-12 items-center">
      <div class="space-y-6 sm:space-y-8">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          {h1}
        </h1>
        <p class="text-lg sm:text-xl text-gray-300 leading-relaxed">
          {subtitulo}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-primary-600 hover:bg-primary-700 px-6 sm:px-8 py-4 rounded-full font-semibold text-base sm:text-lg transition-all hover:scale-105 text-center pulse-glow"
          >
            {ctaTexto}
          </a>
          <a
            href="#portfolio"
            class="border-2 border-primary-500 text-primary-400 hover:bg-primary-500/10 px-6 sm:px-8 py-4 rounded-full font-semibold text-base sm:text-lg transition-all text-center"
          >
            Ver projetos
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
