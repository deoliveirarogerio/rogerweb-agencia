---
const testimonials = [
  {
    quote: 'Excelente profissional! Presta atendimento à nossa empresa há anos, sempre com muita competência, responsabilidade e comprometimento. Atendimento de qualidade, equipe prestativa e serviço de confiança. Recomendo!',
    initials: 'GS',
    name: 'GlauberCDs',
    role: 'SmartSegMed - APECIND (Diretor responsável)',
    avatarBg: 'bg-primary-500/20',
    avatarText: 'text-primary-400',
  },
  {
    quote: 'Gostei bastante do trabalho da Roger. O atendimento foi muito bom e o pessoal foi sempre muito prestativo. Fizeram tudo certinho e dentro do que precisávamos. Recomendo!',
    initials: 'WA',
    name: 'Wilder Amorin',
    role: 'Uebi Agência (Diretor e Parceiro)',
    avatarBg: 'bg-accent-500/20',
    avatarText: 'text-accent-400',
  },
  {
    quote: 'Excelente experiência com a Roger Web! Profissionalismo, atenção e comprometimento em todo o atendimento. O trabalho é realizado com muito cuidado e buscando entender de fato as necessidades do cliente. Recomendo para quem procura uma empresa séria e confiável na área de soluções para web e marketing. Excelente atendimento e suporte! 👏🏻',
    initials: 'EL',
    name: 'Eloíse Lemes',
    role: 'Social Media na FEI São bernardo do Campo',
    avatarBg: 'bg-primary-500/20',
    avatarText: 'text-primary-400',
  },
  {
    quote: 'Trabalho impecável no desenvolvimento e suporte. Sempre muito rápidos na solução de dúvidas, com comunicação clara e entrega pontual. Recomendo fortemente!',
    initials: 'RL',
    name: 'Régis Lemes',
    role: 'Estudante ICJ Santo André',
    avatarBg: 'bg-primary-500/20',
    avatarText: 'text-primary-400',
  },
  {
    quote: 'Obrigada pelo serviço! Com certeza irei indca-los. Empresa idônea, entregou no prazo, preço justo e muito atenciosos.',
    initials: 'EO',
    name: 'Elizabeth Oliver',
    role: 'Professora -Santo André',
    avatarBg: 'bg-primary-500/20',
    avatarText: 'text-primary-400',
  },
];

const starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';
---

<section id="depoimentos" class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 sm:mb-12 gap-6">
      <div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
          O que nossos <span class="gradient-text">clientes</span> dizem
        </h2>
        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl">
          Histórias reais de empresas que transformaram seus resultados com a RogerWeb
        </p>
      </div>
      <div class="flex items-center gap-3">
        <button class="testimonial-prev testimonial-nav-btn w-12 h-12 rounded-full border border-primary-500/30 bg-dark-800/80 text-white flex items-center justify-center hover:text-primary-400 focus:outline-none transition-all shadow-lg" aria-label="Depoimento anterior">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button class="testimonial-next testimonial-nav-btn w-12 h-12 rounded-full border border-primary-500/30 bg-dark-800/80 text-white flex items-center justify-center hover:text-primary-400 focus:outline-none transition-all shadow-lg" aria-label="Próximo depoimento">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="swiper testimonials-swiper">
      <div class="swiper-wrapper">
        {testimonials.map((item) => (
          <div class="swiper-slide h-auto">
            <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8 flex flex-col justify-between w-full h-full card-hover">
              <div>
                <div class="flex items-center mb-4">
                  <div class="flex text-accent-400">
                    {[...Array(5)].map(() => (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d={starPath} />
                      </svg>
                    ))}
                  </div>
                </div>
                {item.quote && (
                  <p class="text-gray-300 mb-6 leading-relaxed">"{item.quote}"</p>
                )}
              </div>
              <div class="flex items-center pt-4 border-t border-primary-500/10">
                <div class={`w-12 h-12 ${item.avatarBg} rounded-full flex items-center justify-center mr-4 flex-shrink-0`}>
                  <span class={`${item.avatarText} font-bold`}>{item.initials}</span>
                </div>
                <div>
                  <h4 class="text-white font-semibold">{item.name}</h4>
                  <p class="text-gray-400 text-sm">{item.role}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/navigation';

  new Swiper('.testimonials-swiper', {
    modules: [Autoplay, Navigation, Pagination],
    slidesPerView: 1,
    spaceBetween: 24,
    loop: true,
    grabCursor: true,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
      pauseOnMouseEnter: true,
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    navigation: {
      nextEl: '.testimonial-next',
      prevEl: '.testimonial-prev',
    },
    breakpoints: {
      640: { slidesPerView: 1, spaceBetween: 24 },
      768: { slidesPerView: 2, spaceBetween: 24 },
      1024: { slidesPerView: 3, spaceBetween: 30 },
    },
  });
</script>
