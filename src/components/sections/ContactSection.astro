---
import ContactForm from '../ContactForm.astro';
import { waLink, WHATSAPP_EXIBICAO } from '../../data/contato';
---

<section id="contato" data-analytics-source="contact_section" class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
        Pronto para <span class="gradient-text">aumentar suas vendas</span>?
      </h2>
      <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto">
        Preencha o formulário e receba uma análise gratuita do seu potencial de crescimento em até 24 horas.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 sm:gap-12">
      <div class="space-y-8">
        <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8">
          <h3 class="text-xl sm:text-2xl font-bold mb-6 text-white">Informações de Contato</h3>
          <div class="space-y-6">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-primary-500/20 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-gray-400 text-sm">E-mail</p>
                <p class="text-white font-semibold">contato@rogerweb.com.br</p>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-accent-500/20 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Telefone</p>
                <p class="text-white font-semibold">(11) 91080-2646</p>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-primary-500/20 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Localização</p>
                <p class="text-white font-semibold">São Paulo, Brasil</p>
              </div>
            </div>
          </div>
        </div>

        <a href={waLink('Olá! Quero falar agora pelo WhatsApp.')} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center space-x-3 bg-green-600 hover:bg-green-700 px-6 sm:px-8 py-4 rounded-full font-semibold text-base sm:text-lg transition-all hover:scale-105">
          <img src="/assets/images/mascote-whatsapp.jpg" alt="WhatsApp" class="w-8 h-8 rounded-full" />
          <span>Resposta em 5 minutos</span>
        </a>
      </div>

      <div class="bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-6 sm:p-8">
        <h3 class="text-xl sm:text-2xl font-bold mb-2 text-white">Análise Gratuita</h3>
        <p class="text-gray-400 mb-6">Descubra quanto você pode aumentar seu faturamento</p>
        <ContactForm />
      </div>
    </div>
  </div>
</section>
