<section id="servicos" class="py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">
        Nossos <span class="gradient-text">Serviços</span>
      </h2>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Soluções completas para levar seu negócio ao próximo nível
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="card-hover bg-dark-800/50 backdrop-blur-sm border border-primary-500/20 rounded-2xl p-8">
          <div class={`w-16 h-16 ${service.iconBg} rounded-xl flex items-center justify-center mb-6`}>
            <svg class={`w-8 h-8 ${service.iconText}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 text-white">{service.title}</h3>
          <p class="text-gray-300 mb-6">{service.description}</p>
          <ul class="space-y-2 text-gray-400">
            {service.features.map((feature) => (
              <li class="flex items-center">
                <svg class={`w-5 h-5 ${service.checkText} mr-2`} fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d={checkIcon} clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
